# InsureBroker — environment template
#
# Shared public values live in tracked `.env` (required for Lovable previews).
# Secrets and personal overrides live in `.env.local` (gitignored; wins over `.env`):
#   cp .env.example .env.local
#
# See README.md and docs/ENV_REVIEW.md.

# -----------------------------------------------------------------------------
# Client (Vite build-time — exposed to the browser)
# -----------------------------------------------------------------------------
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_or_anon_key
VITE_SUPABASE_PROJECT_ID=your_supabase_project_id

# -----------------------------------------------------------------------------
# Server (SSR + TanStack server functions — not VITE_-prefixed)
# Use the same project URL / publishable key as above.
# -----------------------------------------------------------------------------
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_or_anon_key
SUPABASE_PROJECT_ID=your_supabase_project_id

# Required only for admin Auth operations (create/delete user, lock, sessions).
# Put this in `.env.local` only. NEVER prefix with VITE_. NEVER commit a real value.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
